# SEISMIC — environment template.
#
# Copy this file to `.env` and fill in whatever you have. NOTHING here is
# required: the app launches, seeds itself and demonstrates every feature with
# zero keys and zero hardware. Each key simply upgrades a simulated path to a
# live one.
#
# On first launch the app reads `.env` into the iOS Keychain and never needs the
# file again. Settings → API Keys can paste, replace, test or clear any value at
# any time; keys entered there override anything found here.
#
# `.env` is gitignored. This template is committed. Never put a real key here.

# ── AI and voice ────────────────────────────────────────────────────────────
# Primary inference. Chosen for latency: spoken guidance during an event cannot
# wait two seconds for a token stream to start.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# Fallback inference, and the vision path for photo damage analysis and
# photo-to-building modelling.
OPENAI_API_KEY=
# Optional secondary fallback, used for long-form report narrative.
ANTHROPIC_API_KEY=
# Calm emergency voice and the formal spoken readout of an assessment.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Live web search — powers building import ────────────────────────────────
# Primary search provider for resolving a building name to real candidates.
SERPER_API_KEY=
# AI-oriented search with content extraction; used for structured building facts.
TAVILY_API_KEY=
# Fallback search provider.
BRAVE_SEARCH_API_KEY=
# Semantic search, tuned for technical and structural-engineering sources.
EXA_API_KEY=
# Structured building data (height, storeys, architect, year). No key required.
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql

# ── Geospatial and 3D geometry ─────────────────────────────────────────────
# Basemaps, geocoding and place resolution.
GOOGLE_MAPS_API_KEY=
# Photorealistic 3D Tiles — real building geometry where coverage exists.
GOOGLE_3D_TILES_KEY=
# Place details and photos for the import disambiguation list.
GOOGLE_PLACES_API_KEY=
# Alternative basemap and vector tile source.
MAPBOX_ACCESS_TOKEN=
# OpenStreetMap footprints, heights and level counts. No key required.
OVERPASS_API_ENDPOINT=https://overpass-api.de/api/interpreter

# ── Identity and cloud ─────────────────────────────────────────────────────
# Google Sign-In: iOS client ID, and the server client ID used for ID tokens.
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
# Supabase project used for sync, households and the community network.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bucket for event recordings, photos and generated reports.
CLOUD_STORAGE_BUCKET=

# ── Alerts ─────────────────────────────────────────────────────────────────
# SMS escalation to household members who have not checked in after an event.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Push relay for early warning and nearby community tags.
PUSH_SERVER_KEY=

# ── Context data ───────────────────────────────────────────────────────────
# Temperature, used to normalise the measured period so seasonal swings do not
# read as structural damage.
OPENWEATHER_API_KEY=
# Tsunami advisories and coastal context after an offshore event.
NOAA_API_KEY=

# ── Operations ─────────────────────────────────────────────────────────────
# Crash and error reporting.
SENTRY_DSN=
# Product analytics. Opt-in only; nothing is sent unless the user agrees.
ANALYTICS_KEY=

# ── Deliberately keyless ───────────────────────────────────────────────────
# These are live services the app uses that need no credential at all. Listed
# so nobody goes hunting for a key that does not exist.
#   USGS real-time earthquake feed  https://earthquake.usgs.gov/earthquakes/feed/v1.0/
#   USGS aftershock forecasts       https://earthquake.usgs.gov/data/oaf/
#   USGS strong-motion records      https://www.strongmotioncenter.org/
#   OpenStreetMap raster tiles      https://tile.openstreetmap.org/
