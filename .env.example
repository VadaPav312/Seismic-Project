# SEISMIC — environment template.
#
# Copy this file to `.env` and fill in whatever you have. NOTHING here is
# required: the app launches, seeds itself and demonstrates every feature with
# zero keys and zero hardware. Each key simply upgrades a simulated path to a
# live one.
#
# Every capability in this app has a path that costs nothing. Each variable is
# marked accordingly:
#
#   [none]  no account at all — already filled in below
#   [free]  a free tier that does not ask for a card
#   [card]  free to use, but the signup wants a card to verify you
#   [paid]  no free tier; you are buying credit
#
# Set only the [free] ones and every feature works live except SMS escalation
# and photorealistic 3D tiles, both of which fall back cleanly.
#
# On first launch the app reads `.env` into the iOS Keychain and never needs the
# file again. Settings → API Keys can paste, replace, test or clear any value at
# any time; keys entered there override anything found here. That screen hides
# the paid keys by default.
#
# In a debug build a build phase copies your `.env` into the app bundle so it is
# readable on first launch. Release builds never carry it.
#
# `.env` is gitignored. This template is committed. Never put a real key here.

# ── AI and voice ────────────────────────────────────────────────────────────
# [free] Primary inference. Fast enough to speak guidance during an event.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# [free] Free-tier inference, and the vision path for photo damage analysis —
# the one capability that genuinely cannot run on the device.
GEMINI_API_KEY=
# [paid] Another fallback for text, and a second vision path.
OPENAI_API_KEY=
# [paid] Optional secondary fallback, used for long-form report narrative.
ANTHROPIC_API_KEY=
# [free] Calm emergency voice and the formal spoken readout of an assessment.
ELEVENLABS_API_KEY=
# [free] Which ElevenLabs voice to use. Blank picks a calm default.
ELEVENLABS_VOICE_ID=

# ── Live web search — powers building import ────────────────────────────────
# [free] Primary search provider for resolving a building name to candidates.
SERPER_API_KEY=
# [free] AI-oriented search with content extraction; structured building facts.
TAVILY_API_KEY=
# [card] Fallback search provider.
BRAVE_SEARCH_API_KEY=
# [free] Semantic search, tuned for technical and engineering sources.
EXA_API_KEY=
# [none] Structured building data (height, storeys, architect, year).
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql

# ── Geospatial and 3D geometry ─────────────────────────────────────────────
# [paid] Basemaps and geocoding. Not needed: the app's maps are MapKit, which
# comes with the platform, and OpenStreetMap tiles need no key.
GOOGLE_MAPS_API_KEY=
# [paid] Photorealistic 3D Tiles — real building geometry where coverage exists.
GOOGLE_3D_TILES_KEY=
# [paid] Place details and photos for the import disambiguation list.
GOOGLE_PLACES_API_KEY=
# [free] Alternative basemap and vector tile source.
MAPBOX_ACCESS_TOKEN=
# [none] OpenStreetMap footprints, heights and level counts.
OVERPASS_API_ENDPOINT=https://overpass-api.de/api/interpreter

# ── Identity and cloud ─────────────────────────────────────────────────────
# [free] Google Sign-In: iOS client ID, and the server client ID used for ID
# tokens. OAuth clients cost nothing; only the Maps APIs above need billing.
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
# [free] Supabase project used for sync, households and the community network.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# [free] Bucket for event recordings, photos and generated reports.
CLOUD_STORAGE_BUCKET=

# ── Alerts ─────────────────────────────────────────────────────────────────
# [card] SMS escalation to household members who have not checked in. Without
# it the message is prepared for the share sheet so you send it yourself.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# [paid] Push relay for early warning and nearby community tags. Needs an Apple
# Developer account and a server; local notifications work without it.
PUSH_SERVER_KEY=

# ── Context data ───────────────────────────────────────────────────────────
# [free] Temperature, used to normalise the measured period so seasonal swings
# do not read as structural damage. The node's own thermistor is preferred
# anyway, so this only matters when no node is attached.
OPENWEATHER_API_KEY=
# [none] Tsunami advisories and coastal context after an offshore event.
NOAA_API_KEY=

# ── Operations ─────────────────────────────────────────────────────────────
# [free] Crash and error reporting.
SENTRY_DSN=
# [free] Product analytics. Opt-in only; nothing is sent unless the user agrees.
ANALYTICS_KEY=

# ── Deliberately keyless ───────────────────────────────────────────────────
# These are live services the app uses that need no credential at all. Listed
# so nobody goes hunting for a key that does not exist.
#   USGS real-time earthquake feed  https://earthquake.usgs.gov/earthquakes/feed/v1.0/
#   USGS aftershock forecasts       https://earthquake.usgs.gov/data/oaf/
#   USGS strong-motion records      https://www.strongmotioncenter.org/
#   OpenStreetMap raster tiles      https://tile.openstreetmap.org/
#   Apple MapKit                    bundled with iOS
